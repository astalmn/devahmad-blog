---
import Base from '../../layouts/Base.astro';import PhoneFrame from '../../components/PhoneFrame.astro';import {getCollection,render} from 'astro:content';import type {CollectionEntry} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('projects',({data})=>data.lang==='ar')).map(project=>({params:{slug:project.id},props:{project}}));}
const {project}=Astro.props as {project:CollectionEntry<'projects'>};const {Content}=await render(project);
const launchUrl =
  project.id === 'athkari' ? '/apps/athkari/' :
  project.id === 'noor-quran' ? '/apps/noor-quran/' :
  project.data.demo;
---
<Base title={project.data.title} description={project.data.description}><article class="wrap section"><a href="/projects/" class="muted">→ العودة إلى المشاريع</a><h1 class="section-title" style="margin-top:22px">{project.data.title}</h1><p class="muted">{project.data.description}</p><p>{project.data.stack.map(s=><span class="tag" style="margin:4px">{s}</span>)}</p><div class="prose"><Content/></div>{project.id==='athkari'&&<PhoneFrame src="/apps/athkari/" title="تطبيق أذكاري"/>}{project.id==='noor-quran'&&<PhoneFrame src="/apps/noor-quran/" title="تطبيق نور القرآن"/>}<div class="controls">{launchUrl&&<a class="btn" href={launchUrl} target="_blank" rel="noopener noreferrer">تجربة المشروع</a>}{launchUrl&&<a class="btn secondary" href={launchUrl} target="_blank" rel="noopener noreferrer">فتح المشروع</a>}</div></article></Base>
