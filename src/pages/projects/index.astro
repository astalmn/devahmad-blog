---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => data.lang === 'ar');

const preferredOrder = ['zaka-plus', 'athkari', 'noor-quran'];

const projects = [...allProjects].sort((a, b) => {
  const aIndex = preferredOrder.indexOf(a.id);
  const bIndex = preferredOrder.indexOf(b.id);

  if (aIndex !== -1 && bIndex !== -1) return aIndex - bIndex;
  if (aIndex !== -1) return -1;
  if (bIndex !== -1) return 1;

  return a.data.title.localeCompare(b.data.title, 'ar');
});

function groupsFor(project: (typeof projects)[number]) {
  const groups = new Set(['all', 'web']);
  const text = `${project.id} ${project.data.title} ${project.data.description} ${project.data.stack.join(' ')}`.toLowerCase();

  if (
    project.id === 'zaka-plus' ||
    /workers ai|ذكاء اصطناعي|artificial intelligence|\bai\b|\bllm\b/.test(text)
  ) {
    groups.add('ai');
  }

  if (
    ['zaka-plus', 'athkari', 'noor-quran'].includes(project.id) ||
    /tool|tools|أداة|أدوات|مسبحة|بحث|مولد|ترجمة|تلخيص/.test(text)
  ) {
    groups.add('tools');
  }

  return [...groups].join(' ');
}

const counts = {
  all: projects.length,
  web: projects.filter(project => groupsFor(project).split(/\s+/).includes('web')).length,
  ai: projects.filter(project => groupsFor(project).split(/\s+/).includes('ai')).length,
  tools: projects.filter(project => groupsFor(project).split(/\s+/).includes('tools')).length
};
---

<Base
  title="المشاريع"
  description="مشاريع DevAhmad في تطوير الويب والذكاء الاصطناعي والأدوات التفاعلية."
>
  <section class="wrap projects-page">
    <header class="projects-hero">
      <span class="eyebrow">Portfolio · DevAhmad</span>
      <h1>المشاريع</h1>
      <p>
        مجموعة من المشاريع والتجارب العملية في تطوير الويب والذكاء الاصطناعي،
        مع إمكانية فتح كل مشروع وتجربته مباشرة.
      </p>
    </header>

    <div class="project-filters" role="toolbar" aria-label="تصفية المشاريع">
      <button class="filter-btn active" type="button" data-filter="all" aria-pressed="true">
        الكل <span>{counts.all}</span>
      </button>
      <button class="filter-btn" type="button" data-filter="web" aria-pressed="false">
        تطبيقات ويب <span>{counts.web}</span>
      </button>
      <button class="filter-btn" type="button" data-filter="ai" aria-pressed="false">
        ذكاء اصطناعي <span>{counts.ai}</span>
      </button>
      <button class="filter-btn" type="button" data-filter="tools" aria-pressed="false">
        أدوات <span>{counts.tools}</span>
      </button>
    </div>

    <div class="projects-grid" id="projects-grid">
      {projects.map(project => (
        <div
          class="project-item"
          data-groups={groupsFor(project)}
          data-title={project.data.title}
        >
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <div id="projects-empty" class="projects-empty" hidden>
      لا توجد مشاريع ضمن هذا التصنيف حاليًا.
    </div>
  </section>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter-btn')];
  const items = [...document.querySelectorAll<HTMLElement>('.project-item')];
  const empty = document.querySelector<HTMLElement>('#projects-empty');

  function applyFilter(filter: string) {
    let visible = 0;

    items.forEach(item => {
      const groups = (item.dataset.groups || '').split(/\s+/);
      const show = filter === 'all' || groups.includes(filter);
      item.hidden = !show;
      if (show) visible++;
    });

    buttons.forEach(button => {
      const active = button.dataset.filter === filter;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    if (empty) empty.hidden = visible !== 0;

    const url = new URL(location.href);
    if (filter === 'all') url.searchParams.delete('filter');
    else url.searchParams.set('filter', filter);
    history.replaceState({}, '', url);
  }

  buttons.forEach(button => {
    button.addEventListener('click', () => applyFilter(button.dataset.filter || 'all'));
  });

  const requested = new URLSearchParams(location.search).get('filter') || 'all';
  const valid = buttons.some(button => button.dataset.filter === requested);
  applyFilter(valid ? requested : 'all');
</script>

<style>
  .projects-page{
    padding-block:clamp(34px,6vw,72px);
  }

  .projects-hero{
    max-width:760px;
    margin-bottom:32px;
  }

  .projects-hero h1{
    margin:.45rem 0 .7rem;
    font-size:clamp(2.35rem,7vw,4.4rem);
    line-height:1.08;
    letter-spacing:-.035em;
  }

  .projects-hero p{
    margin:0;
    max-width:700px;
    color:var(--muted, #9fb0c7);
    font-size:clamp(1rem,2.2vw,1.1rem);
    line-height:1.9;
  }

  .project-filters{
    display:flex;
    flex-wrap:wrap;
    gap:9px;
    margin:0 0 28px;
    padding-bottom:4px;
  }

  .filter-btn{
    appearance:none;
    border:1px solid rgba(117,153,190,.3);
    border-radius:999px;
    padding:9px 14px;
    color:inherit;
    background:rgba(20,42,70,.42);
    font:inherit;
    font-size:.88rem;
    font-weight:750;
    cursor:pointer;
    transition:.18s ease;
  }

  .filter-btn:hover{
    border-color:rgba(91,211,255,.58);
  }

  .filter-btn span{
    display:inline-grid;
    place-items:center;
    min-width:1.55rem;
    height:1.55rem;
    margin-inline-start:.35rem;
    padding-inline:.32rem;
    border-radius:999px;
    background:rgba(255,255,255,.08);
    font-size:.74rem;
    line-height:1;
  }

  .filter-btn.active{
    color:#04131f;
    border-color:transparent;
    background:linear-gradient(135deg,#71e2ff,#3cb7ff);
    box-shadow:0 8px 24px rgba(55,183,238,.22);
  }

  .filter-btn.active span{
    background:rgba(4,19,31,.12);
  }

  .projects-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:22px;
    align-items:stretch;
  }

  .project-item{
    min-width:0;
    height:100%;
  }

  .project-item[hidden]{
    display:none;
  }

  .project-item :global(.project-card){
    height:100%;
  }

  .projects-empty{
    margin-top:26px;
    padding:28px;
    text-align:center;
    border:1px dashed rgba(126,162,198,.35);
    border-radius:18px;
    color:var(--muted,#9fb0c7);
  }

  :global(html[data-theme="light"]) .filter-btn{
    background:#fff;
    border-color:#d7e2ee;
  }

  :global(html[data-theme="light"]) .filter-btn.active{
    color:#062033;
    background:linear-gradient(135deg,#9beaff,#62c8f2);
  }

  @media(max-width:1000px){
    .projects-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }

  @media(max-width:650px){
    .projects-page{padding-top:28px}
    .project-filters{
      overflow-x:auto;
      flex-wrap:nowrap;
      margin-inline:-4px;
      padding:2px 4px 10px;
      scrollbar-width:none;
    }
    .project-filters::-webkit-scrollbar{display:none}
    .filter-btn{flex:0 0 auto}
    .projects-grid{grid-template-columns:1fr;gap:18px}
  }

  @media(prefers-reduced-motion:reduce){
    .filter-btn{transition:none}
  }
</style>
