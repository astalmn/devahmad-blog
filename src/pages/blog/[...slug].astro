---
import Base from '../../layouts/Base.astro';
import GuestComments from '../../components/GuestComments.astro';
import {getCollection,render} from 'astro:content';
import {posts} from '../../lib/site';
import ArticleCard from '../../components/ArticleCard.astro';
import type {CollectionEntry} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>data.lang==='ar'&&!data.draft)).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props as {post:CollectionEntry<'blog'>};
const {Content,headings}=await render(post);
// Rank published Arabic articles by shared tags, then category; use recency as a tie-breaker.
const currentTags = new Set(post.data.tags.map(tag => tag.trim().toLocaleLowerCase()));
const related = (await posts())
  .filter(p => p.id !== post.id)
  .map(p => {
    const sharedTags = p.data.tags.filter(tag => currentTags.has(tag.trim().toLocaleLowerCase())).length;
    const sameCategory = p.data.category === post.data.category;
    return {p, score: sharedTags * 3 + (sameCategory ? 2 : 0)};
  })
  .filter(item => item.score > 0)
  .sort((a,b) => b.score - a.score || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0,3)
  .map(item => item.p);
const minutes=Math.max(1,Math.ceil((post.body ?? '').split(/\s+/).length/220));
// Extract only valid YouTube video IDs. Never embed arbitrary visitor-provided URLs.
function youtubeId(value: string): string | null {
  try {
    const url = new URL(value);
    const host = url.hostname.toLowerCase();
    let id: string | null = null;
    if (host === 'youtu.be' || host === 'www.youtu.be') id = url.pathname.split('/')[1] || null;
    else if (['youtube.com','www.youtube.com','m.youtube.com'].includes(host)) {
      if (url.pathname === '/watch') id = url.searchParams.get('v');
      else if (url.pathname.startsWith('/shorts/') || url.pathname.startsWith('/embed/')) id = url.pathname.split('/')[2] || null;
    }
    return id && /^[a-zA-Z0-9_-]{11}$/.test(id) ? id : null;
  } catch { return null; }
}
const videos = post.data.videos.map(video => ({...video,id:youtubeId(video.url)})).filter(video => video.id !== null);
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover||'/assets/cover.png'} type="article"><article class="wrap section"><a class="muted" href="/blog/">→ العودة إلى المدونة</a><header style="max-width:800px"><p><span class="tag">{post.data.category}</span></p><h1 style="font-size:clamp(2rem,5vw,3.4rem);line-height:1.3">{post.data.title}</h1><p class="muted">{post.data.description}</p><p class="muted"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ar',{dateStyle:'long'})}</time> · {minutes} دقائق قراءة</p><div class="controls"><button class="btn secondary" id="share">مشاركة</button><button class="btn secondary" id="copylink">نسخ الرابط</button></div></header>{post.data.cover && <figure class="article-cover" style="max-width:1000px;margin:28px 0 0"><img src={post.data.cover} alt={`صورة غلاف: ${post.data.title}`} loading="eager" decoding="async" style="display:block;width:100%;height:auto;max-height:520px;object-fit:cover;border-radius:16px" /></figure>}<div class="article-layout" style="margin-top:35px"><div class="prose"><Content/>{videos.length > 0 && <section class="article-videos" aria-label="فيديوهات المقال"><h2>فيديوهات المقال</h2>{videos.map(video => <div class="article-video"><h3>{video.title}</h3><div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}?controls=1&fs=1&disablekb=0&playsinline=1&rel=0`} title={video.title} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></div>)}</section>}</div><aside><div class="glass" style="padding:18px"><strong>محتويات المقال</strong><nav class="toc" aria-label="محتويات المقال">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} style={`padding-inline-start:${Math.max(0,h.depth-2)*12}px`}>{h.text}</a>)}</nav></div></aside></div>{related.length>0&&<section class="section"><h2 class="section-title">مقالات ذات صلة</h2><div class="cards">{related.map(p=><ArticleCard post={p}/>)}</div></section>}<GuestComments pageId={post.id} title={post.data.title} /></article></Base>
<script>
document.querySelector('#copylink')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);const b=document.querySelector('#copylink');if(b)b.textContent='تم نسخ الرابط'});
document.querySelector('#share')?.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title:document.title,url:location.href})}catch{}}else{await navigator.clipboard.writeText(location.href)}});
</script>
<style>
article.wrap{width:100%;max-width:1200px;margin-inline:auto;box-sizing:border-box;overflow:hidden}
article.wrap *{box-sizing:border-box}
.article-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:32px;align-items:start}
.prose{min-width:0;max-width:100%;overflow-wrap:anywhere}
.prose img,.prose video,.prose iframe,.prose svg{max-width:100%;height:auto}
.prose pre{max-width:100%;overflow-x:auto}
.prose code{overflow-wrap:anywhere}
.prose table{display:block;max-width:100%;overflow-x:auto}
.article-cover{max-width:100%!important}
.article-cover img{max-width:100%}
.article-videos,.article-video,.video-frame{width:100%;max-width:100%}
.video-frame{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:14px}
.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.controls{display:flex;flex-wrap:wrap;gap:10px}
aside{min-width:0}
@media(max-width:768px){
article.wrap{padding-inline:16px!important;overflow:hidden}
article.wrap header{width:100%;max-width:100%!important}
article.wrap h1{font-size:clamp(1.75rem,8vw,2.4rem)!important;overflow-wrap:anywhere}
.article-layout{grid-template-columns:minmax(0,1fr)!important;gap:24px}
.prose{width:100%;max-width:100%;min-width:0}
aside{width:100%;max-width:100%}
.article-cover{width:100%;margin-top:20px!important}
.cards{grid-template-columns:1fr!important}
.controls .btn{max-width:100%}
}
</style>
