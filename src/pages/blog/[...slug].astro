}

/* DevAhmad V2.6 — article navigation & discovery */
.article-pagination{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:2.6rem auto 1rem;max-width:1040px}
.article-nav-card{min-width:0;display:flex;flex-direction:column;gap:.45rem;padding:1rem 1.1rem;border:1px solid var(--article-line);border-radius:14px;background:rgba(10,24,43,.66);color:#eef6ff;text-decoration:none;transition:transform .18s ease,border-color .18s ease,background .18s ease}
.article-nav-card:hover,.article-nav-card:focus-visible{transform:translateY(-2px);border-color:rgba(125,211,252,.55);background:rgba(15,32,57,.86);outline:none}
.article-nav-card.next{text-align:left;align-items:flex-end}
.article-nav-card.previous{text-align:right;align-items:flex-start}
.article-nav-label{color:#7dd3fc;font-size:.88rem;font-weight:700}
.article-nav-card strong{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-height:1.55}
.related-section{padding-top:2rem}
.related-intro{margin-top:-.55rem;margin-bottom:1.15rem}
@media(max-width:640px){.article-pagination{grid-template-columns:1fr;gap:.75rem;margin-top:2rem}.article-pagination>span:empty{display:none}.article-nav-card{padding:.9rem 1rem}.article-nav-card.next{text-align:right;align-items:flex-start}.related-section{padding-top:1.5rem}}

</style>

<script>
const progressBar=document.querySelector('#readingProgress span');
const updateReadingProgress=()=>{
  const article=document.querySelector('.article-page');
  if(!article||!progressBar) return;
  const rect=article.getBoundingClientRect();
  const start=window.scrollY+rect.top;
  const max=Math.max(1,article.scrollHeight-window.innerHeight);
  const value=Math.min(1,Math.max(0,(window.scrollY-start)/max));
  progressBar.style.transform=`scaleX(${value})`;
};
updateReadingProgress();
addEventListener('scroll',updateReadingProgress,{passive:true});
addEventListener('resize',updateReadingProgress,{passive:true});

const tocPanel=document.querySelector('.toc-panel');
const tocToggle=document.querySelector('#tocToggle');
const setTocState=(collapsed)=>{
  if(!tocPanel||!tocToggle) return;
  tocPanel.classList.toggle('is-collapsed',collapsed);
  tocToggle.setAttribute('aria-expanded',String(!collapsed));
};
if(matchMedia('(max-width: 900px)').matches) setTocState(true);
tocToggle?.addEventListener('click',()=>{
  if(!matchMedia('(max-width: 900px)').matches) return;
  setTocState(!tocPanel?.classList.contains('is-collapsed'));
});

// Close the mobile TOC after choosing a section so the article remains unobstructed.
document.querySelectorAll('#articleToc a').forEach(link=>link.addEventListener('click',()=>{
  if(matchMedia('(max-width: 900px)').matches) setTocState(true);
}));

const backToTop=document.querySelector('#backToTop');
const updateBackToTop=()=>backToTop?.classList.toggle('is-visible',window.scrollY>520);
updateBackToTop();
addEventListener('scroll',updateBackToTop,{passive:true});
backToTop?.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));

const tocLinks=[...document.querySelectorAll('.toc a')];
const headingMap=new Map(tocLinks.map(link=>[decodeURIComponent(link.getAttribute('href')?.slice(1)||''),link]));
const observed=[...document.querySelectorAll('.prose h2[id], .prose h3[id]')];
if('IntersectionObserver' in window && observed.length){
  const visible=new Set();
  const markActive=()=>{
    const current=observed.find(h=>visible.has(h)) || observed.slice().reverse().find(h=>h.getBoundingClientRect().top<150);
    tocLinks.forEach(link=>link.classList.toggle('active',Boolean(current&&link===headingMap.get(current.id))));
  };
  const observer=new IntersectionObserver(entries=>{
    entries.forEach(entry=>entry.isIntersecting?visible.add(entry.target):visible.delete(entry.target));
    markActive();
  },{rootMargin:'-90px 0px -68% 0px',threshold:[0,1]});
  observed.forEach(h=>observer.observe(h));
}

document.querySelectorAll('.prose table').forEach((table)=>{
  if(table.parentElement?.classList.contains('table-scroll')) return;
  const wrap=document.createElement('div');
  wrap.className='table-scroll';
  wrap.setAttribute('role','region');
  wrap.setAttribute('aria-label','جدول قابل للتمرير أفقيًا');
  wrap.tabIndex=0;
  table.parentNode?.insertBefore(wrap,table);
  wrap.appendChild(table);
});
document.querySelector('#copylink')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);const b=document.querySelector('#copylink');if(b)b.textContent='تم نسخ الرابط'});
document.querySelector('#share')?.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title:document.title,url:location.href})}catch{}}else{await navigator.clipboard.writeText(location.href)}});
</script>
