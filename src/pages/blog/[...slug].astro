---
import Base from '../../layouts/Base.astro';
import GuestComments from '../../components/GuestComments.astro';
import {getCollection,render} from 'astro:content';
import {posts} from '../../lib/site';
import ArticleCard from '../../components/ArticleCard.astro';
import type {CollectionEntry} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>data.lang==='ar'&&!data.draft)).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props as {post:CollectionEntry<'blog'>};
const {Content,headings}=await render(post);
const allPosts=(await posts()).filter(p=>p.data.lang==='ar'&&!p.data.draft).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const currentIndex=allPosts.findIndex(p=>p.id===post.id);
// Newer article appears as "next" and older article as "previous" in the reading flow.
const nextPost=currentIndex>0?allPosts[currentIndex-1]:null;
const previousPost=currentIndex>=0&&currentIndex<allPosts.length-1?allPosts[currentIndex+1]:null;
const related=allPosts
  .filter(p=>p.id!==post.id)
  .map(p=>({
    post:p,
    score:(p.data.category===post.data.category?3:0)+p.data.tags.filter(tag=>post.data.tags.includes(tag)).length
  }))
  .filter(item=>item.score>0)
  .sort((a,b)=>b.score-a.score||b.post.data.date.getTime()-a.post.data.date.getTime())
  .slice(0,3)
  .map(item=>item.post);
const minutes=Math.max(1,Math.ceil((post.body ?? '').split(/\s+/).length/220));
const canonicalUrl=new URL(Astro.url.pathname,Astro.site ?? 'https://devahmad-blog.pages.dev').toString();
const coverUrl=new URL(post.data.cover||'/assets/cover.png',canonicalUrl).toString();
const articleSchema={
  '@context':'https://schema.org',
  '@type':'BlogPosting',
  headline:post.data.title,
  description:post.data.description,
  image:[coverUrl],
  datePublished:post.data.date.toISOString(),
  inLanguage:'ar',
  mainEntityOfPage:{'@type':'WebPage','@id':canonicalUrl},
  author:{'@type':'Person',name:'DevAhmad'},
  publisher:{'@type':'Organization',name:'DevAhmad'},
  articleSection:post.data.category,
  keywords:post.data.tags.join(', ')
};
// Extract only valid YouTube video IDs. Never embed arbitrary visitor-provided URLs.
function youtubeId(value: string): string | null {
  try {
    const url = new URL(value);
    const host = url.hostname.toLowerCase();
    let id: string | null = null;
    if (host === 'youtu.be' || host === 'www.youtu.be') id = url.pathname.split('/')[1] || null;
    else if (['youtube.com','www.youtube.com','m.youtube.com'].includes(host)) {
      if (url.pathname === '/watch') id = url.searchParams.get('v');
      else if (url.pathname.startsWith('/shorts/') || url.pathname.startsWith('/embed/')) id = url.pathname.split('/')[2] || null;
    }
    return id && /^[a-zA-Z0-9_-]{11}$/.test(id) ? id : null;
  } catch { return null; }
}
const videos = post.data.videos.map(video => ({...video,id:youtubeId(video.url)})).filter(video => video.id !== null);
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover||'/assets/cover.png'} type="article"><Fragment slot="head"><meta property="article:published_time" content={post.data.date.toISOString()}/><meta property="article:section" content={post.data.category}/>{post.data.tags.map(tag=><meta property="article:tag" content={tag}/>)}<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script></Fragment><div class="reading-progress" id="readingProgress" aria-hidden="true"><span></span></div><article class="wrap section article-page"><a class="muted article-back" href="/blog/">→ العودة إلى المدونة</a><header class="article-header"><p><span class="tag">{post.data.category}</span></p><h1 class="article-title">{post.data.title}</h1><p class="muted">{post.data.description}</p><p class="muted"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ar',{dateStyle:'long'})}</time> · {minutes} دقائق قراءة</p><div class="controls"><button class="btn secondary" id="share">مشاركة</button><button class="btn secondary" id="copylink">نسخ الرابط</button></div></header><div class="article-layout"><div class="prose"><Content/>{videos.length > 0 && <section class="article-videos" aria-label="فيديوهات المقال"><h2>فيديوهات المقال</h2>{videos.map(video => <div class="article-video"><h3>{video.title}</h3><div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.title} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></div>)}</section>}</div><aside><div class="glass toc-panel" style="padding:18px"><button class="toc-toggle" id="tocToggle" type="button" aria-expanded="true" aria-controls="articleToc"><strong>محتويات المقال</strong><span aria-hidden="true">⌄</span></button><nav class="toc" id="articleToc" aria-label="محتويات المقال">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} style={`padding-inline-start:${Math.max(0,h.depth-2)*12}px`}>{h.text}</a>)}</nav></div></aside></div>{(previousPost||nextPost)&&<nav class="article-pagination" aria-label="التنقل بين المقالات">{previousPost?<a class="article-nav-card previous" href={`/blog/${previousPost.id}/`}><span class="article-nav-label">← المقال السابق</span><strong>{previousPost.data.title}</strong></a>:<span></span>}{nextPost?<a class="article-nav-card next" href={`/blog/${nextPost.id}/`}><span class="article-nav-label">المقال التالي →</span><strong>{nextPost.data.title}</strong></a>:<span></span>}</nav>}{related.length>0&&<section class="section related-section"><h2 class="section-title">مقالات ذات صلة</h2><p class="muted related-intro">مقالات مختارة حسب التصنيف والوسوم المشتركة.</p><div class="cards">{related.map(p=><ArticleCard post={p}/>)}</div></section>}<GuestComments pageId={post.id} title={post.data.title} /><button class="back-to-top" id="backToTop" type="button" aria-label="العودة إلى أعلى المقال" title="العودة للأعلى">↑</button></article></Base>

<style>
/* DevAhmad V2.3 — refined professional article reading experience */
/* DevAhmad V2.4 — reading navigation and mobile TOC */
/* DevAhmad V2.5 — mobile reading controls */
.back-to-top{position:fixed;inset-inline-end:max(18px,env(safe-area-inset-right));bottom:max(18px,env(safe-area-inset-bottom));width:46px;height:46px;border:1px solid rgba(125,211,252,.28);border-radius:50%;display:grid;place-items:center;background:rgba(10,24,43,.9);color:#eaf6ff;font-size:1.3rem;font-weight:800;box-shadow:0 10px 30px rgba(0,0,0,.28);backdrop-filter:blur(10px);z-index:950;opacity:0;visibility:hidden;transform:translateY(10px);transition:opacity .18s ease,transform .18s ease,visibility .18s ease;cursor:pointer}
.back-to-top.is-visible{opacity:1;visibility:visible;transform:translateY(0)}
.back-to-top:hover,.back-to-top:focus-visible{border-color:#7dd3fc;outline:none;transform:translateY(-2px)}
@media(max-width:900px){.back-to-top{width:44px;height:44px;bottom:max(16px,env(safe-area-inset-bottom));inset-inline-end:14px}}
.reading-progress{position:fixed;top:0;inset-inline:0;height:3px;z-index:1000;pointer-events:none;background:transparent}
.reading-progress span{display:block;width:100%;height:100%;transform:scaleX(0);transform-origin:right center;background:linear-gradient(90deg,#60a5fa,#67e8f9);will-change:transform}
.toc-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:0;border:0;background:transparent;color:inherit;font:inherit;text-align:right;cursor:default}
.toc-toggle span{display:none;font-size:1.15rem;transition:transform .18s ease}
.article-layout :global(.toc a.active){color:#f4f9ff;background:rgba(96,165,250,.11);box-shadow:inset -2px 0 0 var(--accent)}
.article-page{
  --article-text:#d9e4f2;
  --article-muted:#91a4bd;
  --article-line:rgba(148,163,184,.20);
  --article-panel:rgba(15,32,57,.62);
  --accent:#60a5fa;
  --cyan:#67e8f9;
  --success:#4ade80;
  --warning:#fbbf24;
  --danger:#fb7185;
  max-width:1180px;
}
.article-back{display:inline-flex;margin-bottom:1.25rem}
.article-header{max-width:820px;margin-inline:auto;text-align:right}
.article-title{
  margin:.7rem 0 1rem;
  font-size:clamp(2rem,5vw,3.35rem);
  line-height:1.28;
  letter-spacing:-.025em;
}
.article-layout{
  display:grid;
  grid-template-columns:minmax(0,760px) minmax(220px,280px);
  gap:42px;
  align-items:start;
  justify-content:center;
  margin-top:2.25rem;
}
.article-layout > .prose{
  min-width:0;
  max-width:100%;
  overflow:hidden;
}
.article-page,
.article-layout,
.article-layout > .prose{
  box-sizing:border-box;
}
.article-layout :global(.table-scroll){
  width:100%;
  max-width:100%;
  overflow-x:auto;
  overflow-y:hidden;
  overscroll-behavior-x:contain;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:thin;
  margin:1.35rem 0 1.75rem;
  border:1px solid var(--article-line);
  border-radius:14px;
}
.article-layout :global(.table-scroll table){
  margin:0;
  border:0;
}
.article-layout > aside{position:sticky;top:88px}
.article-layout :global(.prose){
  color:var(--article-text);
  font-size:1.12rem;
  line-height:2;
  text-align:right;
  overflow-wrap:break-word;
  direction:rtl;
}
/* Keep Arabic paragraphs stable when Latin technical terms appear inline. */
.article-layout :global(.prose p),
.article-layout :global(.prose li),
.article-layout :global(.prose blockquote),
.article-layout :global(.prose .callout){
  direction:rtl;
  unicode-bidi:plaintext;
}
.article-layout :global(.prose bdi),
.article-layout :global(.prose [dir="ltr"]){
  direction:ltr;
  unicode-bidi:isolate;
}
.article-layout :global(.prose p){margin:0 0 1.35rem}
.article-layout :global(.prose h2){
  margin:3.2rem 0 1.25rem;
  font-size:clamp(1.75rem,3.4vw,2.35rem);
  line-height:1.38;
  letter-spacing:-.02em;
  color:#eef6ff;
}
.article-layout :global(.prose h3){
  margin:2.3rem 0 1rem;
  font-size:clamp(1.35rem,2.6vw,1.7rem);
  line-height:1.45;
  color:#dcecff;
}
.article-layout :global(.prose strong){color:#f3f7fc;font-weight:750}
.article-layout :global(.prose ul),
.article-layout :global(.prose ol){
  margin:1rem 0 1.6rem;
