.article-layout :global(.prose .callout-info){border-inline-start-color:var(--accent);background:rgba(59,130,246,.09)}
.article-layout :global(.prose .callout-tip){border-inline-start-color:var(--success);background:rgba(34,197,94,.08)}
.article-layout :global(.prose .callout-warning){border-inline-start-color:var(--warning);background:rgba(245,158,11,.08)}
.article-layout :global(.prose .callout-important){border-inline-start-color:var(--danger);background:rgba(244,63,94,.08)}
.article-layout :global(.prose .callout > :first-child){margin-top:0}
.article-layout :global(.prose .callout > :last-child){margin-bottom:0}
.article-layout :global(.prose .callout strong:first-child){color:#f8fbff}
.article-layout :global(.prose hr){
  height:1px;
  border:0;
  margin:2.4rem 0;
  background:linear-gradient(90deg,transparent,var(--article-line),transparent);
}
.article-layout :global(.prose h2::after){
