---
import Base from '../../layouts/Base.astro';
import GuestComments from '../../components/GuestComments.astro';
import {getCollection,render} from 'astro:content';
import {posts} from '../../lib/site';
import ArticleCard from '../../components/ArticleCard.astro';
import type {CollectionEntry} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>data.lang==='ar'&&!data.draft)).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props as {post:CollectionEntry<'blog'>};
const {Content,headings}=await render(post);
// Rank published Arabic articles by shared tags, then category; use recency as a tie-breaker.
const currentTags = new Set(post.data.tags.map(tag => tag.trim().toLocaleLowerCase()));
const related = (await posts())
  .filter(p => p.id !== post.id)
  .map(p => {
    const sharedTags = p.data.tags.filter(tag => currentTags.has(tag.trim().toLocaleLowerCase())).length;
    const sameCategory = p.data.category === post.data.category;
    return {p, score: sharedTags * 3 + (sameCategory ? 2 : 0)};
  })
  .filter(item => item.score > 0)
  .sort((a,b) => b.score - a.score || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0,3)
  .map(item => item.p);
const minutes=Math.max(1,Math.ceil((post.body ?? '').split(/\s+/).length/220));
// Extract only valid YouTube video IDs. Never embed arbitrary visitor-provided URLs.
function youtubeId(value: string): string | null {
  try {
    const url = new URL(value);
    const host = url.hostname.toLowerCase();
    let id: string | null = null;
    if (host === 'youtu.be' || host === 'www.youtu.be') id = url.pathname.split('/')[1] || null;
    else if (['youtube.com','www.youtube.com','m.youtube.com'].includes(host)) {
      if (url.pathname === '/watch') id = url.searchParams.get('v');
      else if (url.pathname.startsWith('/shorts/') || url.pathname.startsWith('/embed/')) id = url.pathname.split('/')[2] || null;
    }
    return id && /^[a-zA-Z0-9_-]{11}$/.test(id) ? id : null;
  } catch { return null; }
}
const videos = post.data.videos.map(video => ({...video,id:youtubeId(video.url)})).filter(video => video.id !== null);
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover||'/assets/cover.png'} type="article"><div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div><article class="wrap section"><a class="muted" href="/blog/">→ العودة إلى المدونة</a><header style="max-width:800px"><p><span class="tag">{post.data.category}</span></p><h1 style="font-size:clamp(2rem,5vw,3.4rem);line-height:1.3">{post.data.title}</h1><p class="muted">{post.data.description}</p><p class="muted"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ar',{dateStyle:'long'})}</time> · {minutes} دقائق قراءة</p><div class="controls"><button class="btn secondary" id="share">مشاركة</button><button class="btn secondary" id="copylink">نسخ الرابط</button></div></header>{post.data.cover && <figure class="article-cover" style="max-width:1000px;margin:28px 0 0"><img src={post.data.cover} alt={`صورة غلاف: ${post.data.title}`} loading="eager" decoding="async" style="display:block;width:100%;height:auto;max-height:520px;object-fit:cover;border-radius:16px" /></figure>}<div class="article-layout" style="margin-top:35px"><div class="prose"><Content/>{videos.length > 0 && <section class="article-videos" aria-label="فيديوهات المقال"><h2>فيديوهات المقال</h2>{videos.map(video => <div class="article-video"><h3>{video.title}</h3><div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}?controls=1&fs=1&disablekb=0&playsinline=1&rel=0`} title={video.title} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></div>)}</section>}</div><aside><div class="glass toc-card" style="padding:18px"><button class="toc-toggle" id="toc-toggle" type="button" aria-expanded="false" aria-controls="article-toc"><span>محتويات المقال</span><span class="toc-chevron" aria-hidden="true">⌄</span></button><strong class="toc-title">محتويات المقال</strong><nav class="toc" id="article-toc" aria-label="محتويات المقال">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} style={`padding-inline-start:${Math.max(0,h.depth-2)*12}px`}>{h.text}</a>)}</nav></div></aside></div>{related.length>0&&<section class="section"><h2 class="section-title">مقالات ذات صلة</h2><div class="cards">{related.map(p=><ArticleCard post={p}/>)}</div></section>}<GuestComments pageId={post.id} title={post.data.title} /></article></Base>
<script>
const copyLink=document.querySelector('#copylink');
copyLink?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);copyLink.textContent='تم نسخ الرابط';setTimeout(()=>copyLink.textContent='نسخ الرابط',1600)});
document.querySelector('#share')?.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title:document.title,url:location.href})}catch{}}else{await navigator.clipboard.writeText(location.href)}});

const article=document.querySelector('article.wrap');
const progressBar=document.querySelector('#reading-progress-bar');
function updateReadingProgress(){
  if(!article||!progressBar)return;
  const rect=article.getBoundingClientRect();
  const start=window.scrollY+rect.top;
  const end=start+article.scrollHeight-window.innerHeight;
  const value=end<=start?100:Math.min(100,Math.max(0,((window.scrollY-start)/(end-start))*100));
  progressBar.style.width=`${value}%`;
}
updateReadingProgress();
addEventListener('scroll',updateReadingProgress,{passive:true});
addEventListener('resize',updateReadingProgress);

const tocToggle=document.querySelector('#toc-toggle');
const toc=document.querySelector('#article-toc');
tocToggle?.addEventListener('click',()=>{
  const open=tocToggle.getAttribute('aria-expanded')==='true';
  tocToggle.setAttribute('aria-expanded',String(!open));
  toc?.classList.toggle('is-open',!open);
});
toc?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{
  if(matchMedia('(max-width: 768px)').matches){toc?.classList.remove('is-open');tocToggle?.setAttribute('aria-expanded','false')}
}));

const tocLinks=[...document.querySelectorAll('#article-toc a')];
const headingMap=tocLinks.map(link=>{const id=decodeURIComponent(link.getAttribute('href')?.slice(1)||'');return {link,heading:document.getElementById(id)}}).filter(item=>item.heading);
if(headingMap.length){
  const observer=new IntersectionObserver(entries=>{
    const visible=entries.filter(entry=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top)[0];
    if(!visible)return;
    tocLinks.forEach(link=>link.removeAttribute('aria-current'));
    headingMap.find(item=>item.heading===visible.target)?.link.setAttribute('aria-current','location');
  },{rootMargin:'-18% 0px -68% 0px',threshold:0});
  headingMap.forEach(item=>observer.observe(item.heading));
}

const languageLabels={js:'JavaScript',javascript:'JavaScript',ts:'TypeScript',typescript:'TypeScript',html:'HTML',css:'CSS',python:'Python',py:'Python',bash:'Bash',shell:'Shell',sh:'Shell',json:'JSON',astro:'Astro',md:'Markdown',markdown:'Markdown',sql:'SQL'};
document.querySelectorAll('.prose pre').forEach((pre,index)=>{
  if(pre.closest('.code-block'))return;
  const code=pre.querySelector('code');
  const match=[...(code?.classList||[])].find(c=>c.startsWith('language-'));
  const raw=match?.replace('language-','')||'';
  const language=languageLabels[raw]||raw||'Code';
  const wrapper=document.createElement('div');
  wrapper.className='code-block';
  const header=document.createElement('div');
  header.className='code-header';
  const label=document.createElement('span');label.textContent=language;
  const button=document.createElement('button');button.type='button';button.className='code-copy';button.setAttribute('aria-label',`نسخ الكود ${index+1}`);button.textContent='نسخ';
  button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(code?.textContent||pre.textContent||'');button.textContent='تم النسخ';setTimeout(()=>button.textContent='نسخ',1600)}catch{button.textContent='تعذر النسخ'}});
  header.append(label,button);
  pre.parentNode?.insertBefore(wrapper,pre);wrapper.append(header,pre);
});
</script>
<style>

.reading-progress{position:fixed;inset:0 0 auto 0;height:3px;z-index:999;background:rgba(7,18,37,.5);pointer-events:none}
.reading-progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,#36c8ff,#5b8cff);transition:width .08s linear}
.toc-card{position:sticky;top:20px}
.toc-toggle{display:none}
.toc a{border-inline-start:2px solid transparent;padding-inline-start:10px;transition:color .18s,border-color .18s,background .18s}
.toc a[aria-current="location"]{color:#70dfff;border-inline-start-color:#36c8ff;background:rgba(54,200,255,.07);border-radius:6px}
.prose h2,.prose h3{scroll-margin-top:28px}
.prose figure{margin:1.8rem 0}
.prose img{display:block;margin:1.6rem auto;border-radius:14px;border:1px solid #29466a;box-shadow:0 14px 34px rgba(0,0,0,.18)}
.prose figcaption{text-align:center;color:#a9bed9;font-size:.9rem;margin-top:-.8rem}
.prose table{border-collapse:collapse;border-radius:12px;margin:1.5rem 0;background:#0a192c}
.prose th{background:#102848;color:#eaf2ff}
.code-block{direction:ltr;text-align:left;margin:1.6rem 0;border:1px solid #27476b;border-radius:14px;overflow:hidden;background:#0a192c}
.code-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 12px;background:#102848;border-bottom:1px solid #27476b;color:#a9bed9;font:600 .82rem/1.4 system-ui,sans-serif}
.code-copy{border:1px solid #355b82;border-radius:8px;background:#0d203a;color:#eaf2ff;padding:5px 11px;font:700 .8rem/1.4 system-ui,sans-serif}
.code-copy:hover{border-color:#4bd7ff;color:#fff}
.code-block pre{margin:0!important;border:0!important;border-radius:0!important;background:transparent!important}
article.wrap{width:100%;max-width:1200px;margin-inline:auto;box-sizing:border-box;overflow:hidden}
article.wrap *{box-sizing:border-box}
.article-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:32px;align-items:start}
.prose{min-width:0;max-width:100%;overflow-wrap:anywhere}
.prose img,.prose video,.prose iframe,.prose svg{max-width:100%;height:auto}
.prose pre{max-width:100%;overflow-x:auto}
.prose code{overflow-wrap:anywhere}
.prose table{display:block;max-width:100%;overflow-x:auto}
.article-cover{max-width:100%!important}
.article-cover img{max-width:100%}
.article-videos,.article-video,.video-frame{width:100%;max-width:100%}
.video-frame{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:14px}
.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.controls{display:flex;flex-wrap:wrap;gap:10px}
aside{min-width:0}
@media(max-width:768px){
.toc-card{position:static;padding:0!important;overflow:hidden}
.toc-title{display:none}
.toc-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;border:0;background:transparent;color:#eaf2ff;padding:16px 18px;font-weight:800;text-align:right}
.toc-chevron{font-size:1.25rem;transition:transform .18s}
.toc-toggle[aria-expanded="true"] .toc-chevron{transform:rotate(180deg)}
.toc{display:none;padding:0 18px 16px}
.toc.is-open{display:block}
.toc a{padding-block:7px}
.code-header{position:sticky;left:0}
.code-block pre{font-size:.88rem}

article.wrap{padding-inline:16px!important;overflow:hidden}
article.wrap header{width:100%;max-width:100%!important}
article.wrap h1{font-size:clamp(1.75rem,8vw,2.4rem)!important;overflow-wrap:anywhere}
.article-layout{grid-template-columns:minmax(0,1fr)!important;gap:24px}
.prose{width:100%;max-width:100%;min-width:0}
aside{width:100%;max-width:100%}
.article-cover{width:100%;margin-top:20px!important}
.cards{grid-template-columns:1fr!important}
.controls .btn{max-width:100%}
}
</style>
