---
import Base from '../../layouts/Base.astro';
import GuestComments from '../../components/GuestComments.astro';
import {getCollection,render} from 'astro:content';
import {posts} from '../../lib/site';
import ArticleCard from '../../components/ArticleCard.astro';
import type {CollectionEntry} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>data.lang==='ar'&&!data.draft)).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props as {post:CollectionEntry<'blog'>};
const {Content,headings}=await render(post);
const related=(await posts()).filter(p=>p.id!==post.id&&(p.data.category===post.data.category||p.data.tags.some(tag=>post.data.tags.includes(tag)))).slice(0,3);
const minutes=Math.max(1,Math.ceil((post.body ?? '').split(/\s+/).length/220));
// Extract only valid YouTube video IDs. Never embed arbitrary visitor-provided URLs.
function youtubeId(value: string): string | null {
  try {
    const url = new URL(value);
    const host = url.hostname.toLowerCase();
    let id: string | null = null;
    if (host === 'youtu.be' || host === 'www.youtu.be') id = url.pathname.split('/')[1] || null;
    else if (['youtube.com','www.youtube.com','m.youtube.com'].includes(host)) {
      if (url.pathname === '/watch') id = url.searchParams.get('v');
      else if (url.pathname.startsWith('/shorts/') || url.pathname.startsWith('/embed/')) id = url.pathname.split('/')[2] || null;
    }
    return id && /^[a-zA-Z0-9_-]{11}$/.test(id) ? id : null;
  } catch { return null; }
}
const videos = post.data.videos.map(video => ({...video,id:youtubeId(video.url)})).filter(video => video.id !== null);
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover||'/assets/cover.png'} type="article"><article class="wrap section article-page"><a class="muted article-back" href="/blog/">→ العودة إلى المدونة</a><header class="article-header"><p><span class="tag">{post.data.category}</span></p><h1 class="article-title">{post.data.title}</h1><p class="muted">{post.data.description}</p><p class="muted"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ar',{dateStyle:'long'})}</time> · {minutes} دقائق قراءة</p><div class="controls"><button class="btn secondary" id="share">مشاركة</button><button class="btn secondary" id="copylink">نسخ الرابط</button></div></header><div class="article-layout"><div class="prose"><Content/>{videos.length > 0 && <section class="article-videos" aria-label="فيديوهات المقال"><h2>فيديوهات المقال</h2>{videos.map(video => <div class="article-video"><h3>{video.title}</h3><div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.title} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></div>)}</section>}</div><aside><div class="glass" style="padding:18px"><strong>محتويات المقال</strong><nav class="toc" aria-label="محتويات المقال">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} style={`padding-inline-start:${Math.max(0,h.depth-2)*12}px`}>{h.text}</a>)}</nav></div></aside></div>{related.length>0&&<section class="section"><h2 class="section-title">مقالات ذات صلة</h2><div class="cards">{related.map(p=><ArticleCard post={p}/>)}</div></section>}<GuestComments pageId={post.id} title={post.data.title} /></article></Base>

<style>
/* DevAhmad V2.3 — refined professional article reading experience */
.article-page{
  --article-text:#d9e4f2;
  --article-muted:#91a4bd;
  --article-line:rgba(148,163,184,.20);
  --article-panel:rgba(15,32,57,.62);
  --accent:#60a5fa;
  --cyan:#67e8f9;
  --success:#4ade80;
  --warning:#fbbf24;
  --danger:#fb7185;
  max-width:1180px;
}
.article-back{display:inline-flex;margin-bottom:1.25rem}
.article-header{max-width:820px;margin-inline:auto;text-align:right}
.article-title{
  margin:.7rem 0 1rem;
  font-size:clamp(2rem,5vw,3.35rem);
  line-height:1.28;
  letter-spacing:-.025em;
}
.article-layout{
  display:grid;
  grid-template-columns:minmax(0,760px) minmax(220px,280px);
  gap:42px;
  align-items:start;
  justify-content:center;
  margin-top:2.25rem;
}
.article-layout > .prose{
  min-width:0;
  max-width:100%;
  overflow:hidden;
}
.article-page,
.article-layout,
.article-layout > .prose{
  box-sizing:border-box;
}
.article-layout :global(.table-scroll){
  width:100%;
  max-width:100%;
  overflow-x:auto;
  overflow-y:hidden;
  overscroll-behavior-x:contain;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:thin;
  margin:1.35rem 0 1.75rem;
  border:1px solid var(--article-line);
  border-radius:14px;
}
.article-layout :global(.table-scroll table){
  margin:0;
  border:0;
}
.article-layout > aside{position:sticky;top:88px}
.article-layout :global(.prose){
  color:var(--article-text);
  font-size:1.12rem;
  line-height:2;
  text-align:right;
  overflow-wrap:break-word;
}
.article-layout :global(.prose p){margin:0 0 1.35rem}
.article-layout :global(.prose h2){
  margin:3.2rem 0 1.25rem;
  font-size:clamp(1.75rem,3.4vw,2.35rem);
  line-height:1.38;
  letter-spacing:-.02em;
  color:#eef6ff;
}
.article-layout :global(.prose h3){
  margin:2.3rem 0 1rem;
  font-size:clamp(1.35rem,2.6vw,1.7rem);
  line-height:1.45;
  color:#dcecff;
}
.article-layout :global(.prose strong){color:#f3f7fc;font-weight:750}
.article-layout :global(.prose ul),
.article-layout :global(.prose ol){
  margin:1rem 0 1.6rem;
  padding-inline-start:1.65rem;
}
.article-layout :global(.prose li){margin:.38rem 0;padding-inline-start:.25rem}
.article-layout :global(.prose li::marker){color:var(--accent);font-weight:700}
.article-layout :global(.prose a){color:#7dd3fc;text-decoration-thickness:1px;text-underline-offset:4px}
.article-layout :global(.prose code){
  direction:ltr;
  unicode-bidi:embed;
  font-size:.88em;
}
.article-layout :global(.prose :not(pre) > code){
  display:inline-block;
  padding:.08em .42em;
  border:1px solid rgba(96,165,250,.20);
  border-radius:7px;
  background:rgba(15,32,57,.82);
  color:#bae6fd;
  line-height:1.55;
}
.article-layout :global(.prose pre){
  direction:ltr;
  text-align:left;
  max-width:100%;
  overflow:auto;
  border:1px solid var(--article-line);
  border-radius:14px;
}
.article-layout :global(.prose table){
  width:100%;
  min-width:620px;
  border-collapse:collapse;
  font-size:.96rem;
}
.article-layout :global(.prose table th),
.article-layout :global(.prose table td){
  min-width:145px;
  padding:.8rem .9rem;
  vertical-align:top;
  border-inline-start:1px solid var(--article-line);
  border-bottom:1px solid var(--article-line);
}
.article-layout :global(.prose table tr:last-child td){border-bottom:0}
.article-layout :global(.prose table th:first-child),
.article-layout :global(.prose table td:first-child){border-inline-start:0}
.article-layout :global(.prose table th){
  background:rgba(37,99,235,.12);
  color:#e7f1ff;
  font-weight:700;
}

.article-layout :global(.prose blockquote){
  margin:1.5rem 0;
  padding:.9rem 1.1rem;
  border-inline-start:3px solid var(--accent);
  background:rgba(96,165,250,.07);
  border-radius:10px;
}
.article-layout :global(.prose .callout){
  margin:1.6rem 0;
  padding:1rem 1.05rem;
  border:1px solid var(--article-line);
  border-inline-start-width:4px;
  border-radius:14px;
  background:var(--article-panel);
  line-height:1.85;
}
.article-layout :global(.prose .callout-info){border-inline-start-color:var(--accent);background:rgba(59,130,246,.09)}
.article-layout :global(.prose .callout-tip){border-inline-start-color:var(--success);background:rgba(34,197,94,.08)}
.article-layout :global(.prose .callout-warning){border-inline-start-color:var(--warning);background:rgba(245,158,11,.08)}
.article-layout :global(.prose .callout-important){border-inline-start-color:var(--danger);background:rgba(244,63,94,.08)}
.article-layout :global(.prose .callout > :first-child){margin-top:0}
.article-layout :global(.prose .callout > :last-child){margin-bottom:0}
.article-layout :global(.prose .callout strong:first-child){color:#f8fbff}
.article-layout :global(.prose hr){
  height:1px;
  border:0;
  margin:2.4rem 0;
  background:linear-gradient(90deg,transparent,var(--article-line),transparent);
}
.article-layout :global(.prose h2::after){
  content:"";
  display:block;
  width:52px;
  height:3px;
  margin-top:.55rem;
  border-radius:999px;
  background:linear-gradient(90deg,var(--accent),var(--cyan));
}
.article-layout > aside .glass{
  border:1px solid var(--article-line);
  background:rgba(10,24,43,.72);
  backdrop-filter:blur(14px);
}
.article-layout :global(.toc){display:grid;gap:.18rem;margin-top:.75rem}
.article-layout :global(.toc a){
  display:block;
  padding-block:.42rem;
  color:var(--article-muted);
  text-decoration:none;
  line-height:1.55;
  border-radius:8px;
  transition:color .18s ease,background .18s ease;
}
.article-layout :global(.toc a:hover),
.article-layout :global(.toc a:focus-visible){
  color:#eaf4ff;
  background:rgba(96,165,250,.08);
  outline:none;
}
.article-layout :global(.prose .text-accent){color:#7dd3fc;font-weight:700}
.article-layout :global(.prose .text-success){color:#86efac;font-weight:700}
.article-layout :global(.prose .text-warning){color:#fde68a;font-weight:700}
.article-layout :global(.prose .text-danger){color:#fda4af;font-weight:700}
.article-layout :global(.prose .text-highlight){
  color:#fff4c2;
  font-weight:700;
  background:rgba(251,191,36,.16);
  border:1px solid rgba(251,191,36,.22);
  border-radius:.32em;
  padding:.04em .28em;
  box-decoration-break:clone;
  -webkit-box-decoration-break:clone;
}
.article-layout :global(.prose img){
  max-width:100%;
  height:auto;
  border-radius:14px;
}
.video-frame{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:14px}
.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

@media (max-width:900px){
  .article-layout{grid-template-columns:minmax(0,1fr);gap:1.25rem}
  .article-layout > aside{position:static;order:-1}
}
@media (max-width:640px){
  .article-page{
    width:100%;
    padding-inline:16px;
  }
  .article-header{max-width:none}
  .article-title{
    font-size:clamp(1.85rem,8.2vw,2.35rem);
    line-height:1.34;
    margin:.55rem 0 .8rem;
  }
  .article-header > :global(.muted){font-size:.94rem;line-height:1.75}
  .article-layout{margin-top:1.65rem}
  .article-layout :global(.prose){
    font-size:1.03rem;
    line-height:1.9;
  }
  .article-layout :global(.prose p){margin-bottom:1.15rem}
  .article-layout :global(.prose h2){
    margin:2.55rem 0 1rem;
    font-size:1.72rem;
    line-height:1.42;
  }
  .article-layout :global(.prose h3){
    margin:2rem 0 .85rem;
    font-size:1.35rem;
  }
  .article-layout :global(.prose ul),
  .article-layout :global(.prose ol){
    padding-inline-start:1.35rem;
    margin-bottom:1.35rem;
  }
  .article-layout :global(.prose .callout){
    margin:1.35rem 0;
    padding:.9rem .95rem;
    border-radius:12px;
  }
  .article-layout :global(.prose table){
    width:100%;
    min-width:620px;
    font-size:.9rem;
  }
  .article-layout :global(.table-scroll){
    margin-inline:0;
    border-radius:12px;
  }
  .article-layout :global(.prose table th),
  .article-layout :global(.prose table td){
    min-width:155px;
    padding:.7rem .75rem;
  }
  .controls{gap:.55rem;flex-wrap:wrap}
  .controls .btn{min-height:42px}
}
</style>

<script>
document.querySelectorAll('.prose table').forEach((table)=>{
  if(table.parentElement?.classList.contains('table-scroll')) return;
  const wrap=document.createElement('div');
  wrap.className='table-scroll';
  wrap.setAttribute('role','region');
  wrap.setAttribute('aria-label','جدول قابل للتمرير أفقيًا');
  wrap.tabIndex=0;
  table.parentNode?.insertBefore(wrap,table);
  wrap.appendChild(table);
});
document.querySelector('#copylink')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);const b=document.querySelector('#copylink');if(b)b.textContent='تم نسخ الرابط'});
document.querySelector('#share')?.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title:document.title,url:location.href})}catch{}}else{await navigator.clipboard.writeText(location.href)}});
</script>
