---
import Base from '../../layouts/Base.astro';
import GuestComments from '../../components/GuestComments.astro';
import {getCollection,render} from 'astro:content';
import {posts} from '../../lib/site';
import ArticleCard from '../../components/ArticleCard.astro';
import type {CollectionEntry} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>data.lang==='ar'&&!data.draft)).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props as {post:CollectionEntry<'blog'>};
const {Content,headings}=await render(post);
const related=(await posts()).filter(p=>p.id!==post.id&&(p.data.category===post.data.category||p.data.tags.some(tag=>post.data.tags.includes(tag)))).slice(0,3);
const minutes=Math.max(1,Math.ceil((post.body ?? '').split(/\s+/).length/220));
// Extract only valid YouTube video IDs. Never embed arbitrary visitor-provided URLs.
function youtubeId(value: string): string | null {
  try {
    const url = new URL(value);
    const host = url.hostname.toLowerCase();
    let id: string | null = null;
    if (host === 'youtu.be' || host === 'www.youtu.be') id = url.pathname.split('/')[1] || null;
    else if (['youtube.com','www.youtube.com','m.youtube.com'].includes(host)) {
      if (url.pathname === '/watch') id = url.searchParams.get('v');
      else if (url.pathname.startsWith('/shorts/') || url.pathname.startsWith('/embed/')) id = url.pathname.split('/')[2] || null;
    }
    return id && /^[a-zA-Z0-9_-]{11}$/.test(id) ? id : null;
  } catch { return null; }
}
const videos = post.data.videos.map(video => ({...video,id:youtubeId(video.url)})).filter(video => video.id !== null);
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover||'/assets/cover.png'} type="article"><article class="wrap section"><a class="muted" href="/blog/">→ العودة إلى المدونة</a><header style="max-width:800px"><p><span class="tag">{post.data.category}</span></p><h1 style="font-size:clamp(2rem,5vw,3.4rem);line-height:1.3">{post.data.title}</h1><p class="muted">{post.data.description}</p><p class="muted"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ar',{dateStyle:'long'})}</time> · {minutes} دقائق قراءة</p><div class="controls"><button class="btn secondary" id="share">مشاركة</button><button class="btn secondary" id="copylink">نسخ الرابط</button></div></header>{post.data.cover && <figure class="article-cover" style="max-width:1000px;margin:28px 0 0"><img src={post.data.cover} alt={`صورة غلاف: ${post.data.title}`} loading="eager" decoding="async" style="display:block;width:100%;height:auto;max-height:520px;object-fit:cover;border-radius:16px" /></figure>}<div class="article-layout" style="margin-top:35px"><div class="prose"><Content/>{videos.length > 0 && <section class="article-videos" aria-label="فيديوهات المقال"><h2>فيديوهات المقال</h2>{videos.map(video => <div class="article-video"><h3>{video.title}</h3><div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.title} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></div>)}</section>}</div><aside><div class="glass" style="padding:18px"><strong>محتويات المقال</strong><nav class="toc" aria-label="محتويات المقال">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} style={`padding-inline-start:${Math.max(0,h.depth-2)*12}px`}>{h.text}</a>)}</nav></div></aside></div>{related.length>0&&<section class="section"><h2 class="section-title">مقالات ذات صلة</h2><div class="cards">{related.map(p=><ArticleCard post={p}/>)}</div></section>}<GuestComments pageId={post.id} title={post.data.title} /></article></Base>
<script>
document.querySelector('#copylink')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);const b=document.querySelector('#copylink');if(b)b.textContent='تم نسخ الرابط'});
document.querySelector('#share')?.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title:document.title,url:location.href})}catch{}}else{await navigator.clipboard.writeText(location.href)}});
</script>
