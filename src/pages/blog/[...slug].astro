  }
  .article-layout :global(.prose p){margin-bottom:1.15rem}
  .article-layout :global(.prose h2){
    margin:2.25rem 0 .9rem;
    font-size:clamp(1.48rem,6.5vw,1.62rem);
    line-height:1.4;
  }
  .article-layout :global(.prose h3){
    margin:1.7rem 0 .75rem;
    font-size:1.28rem;
    line-height:1.48;
  }
  .article-layout :global(.prose ul),
  .article-layout :global(.prose ol){
    padding-inline-start:1.35rem;
    margin-bottom:1.35rem;
  }
  .article-layout :global(.prose .callout){
    margin:1.15rem 0 1.3rem;
    padding:.88rem .95rem;
    border-radius:12px;
  }
  .article-layout :global(.prose table){
    width:100%;
    min-width:620px;
    font-size:.9rem;
  }
  .article-layout :global(.table-scroll){
    margin-inline:0;
    border-radius:12px;
  }
  .article-layout :global(.prose table th),
  .article-layout :global(.prose table td){
    min-width:155px;
    padding:.7rem .75rem;
  }
  .toc-panel{padding:14px !important}
  .toc-toggle{cursor:pointer;min-height:28px}
  .toc-toggle span{display:inline-block}
  .toc-panel.is-collapsed .toc-toggle span{transform:rotate(90deg)}
  .toc-panel.is-collapsed .toc{display:none}
  .toc-panel .toc{margin-top:.65rem}
