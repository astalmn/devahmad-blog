---
import Base from '../../layouts/Base.astro';import ArticleCard from '../../components/ArticleCard.astro';import {copy,posts,site} from '../../lib/site';import {getCollection} from 'astro:content';
export function getStaticPaths(){return [{params:{lang:'en'}},{params:{lang:'ar'}}]}
const lang=Astro.params.lang as 'en'|'ar';const t=copy[lang];const all=await posts(lang);const projects=(await getCollection('projects',({data})=>data.lang===lang)).slice(0,3);
---
<Base lang={lang} title="Home" description="DevAhmad — programming, AI and intelligent systems"><div class="wrap"><section class="hero"><img src="/assets/cover.png" width="1536" height="614" fetchpriority="high" alt="DevAhmad coding workspace and personal branding"/><div class="hero-content"><span class="tag">{t.intro}</span><h1><span class="gradient">Dev</span>Ahmad</h1><p style="font-size:1.2rem">{t.hello}</p><p style="letter-spacing:.15em;color:#bcd7f4">IDEAS / CODE / SMARTER SYSTEMS</p><div class="controls"><a class="btn" href={`/${lang}/blog/`}>{t.browse}</a><a class="btn secondary" href={`/${lang}/projects/`}>{t.projects}</a></div></div></section><section class="section"><h2>{t.latest}</h2><div class="cards">{all.slice(0,3).map(post=><ArticleCard post={post}/>)}</div><p style="margin-top:25px"><a class="btn secondary" href={`/${lang}/blog/`}>{t.viewAll}</a></p></section><section class="section"><h2>{lang==='ar'?'المجالات التقنية':'Explore topics'}</h2><div class="cards">{['TypeScript','Artificial Intelligence','Intelligent Systems','Web Development','Cybersecurity','Engineering'].map(x=><a class="glass card" href={`/${lang}/blog/?category=${encodeURIComponent(x)}`}><span style="font-size:2rem;color:#42d9ff">⌘</span><strong>{x}</strong></a>)}</div></section><section class="section"><h2>{t.featured}</h2><div class="cards">{projects.map(project=><a class="glass card" href={`/${lang}/projects/${project.id}/`}><span class="tag">{project.data.stack.join(' / ')}</span><h3>{project.data.title}</h3><p class="muted">{project.data.description}</p></a>)}</div></section><section class="section glass" style="padding:32px;margin-bottom:60px;display:flex;align-items:center;gap:28px;flex-wrap:wrap"><img src="/assets/profile.png" alt="DevAhmad portrait" width="180" height="180" loading="lazy" style="width:180px;height:180px;border-radius:50%;object-fit:cover"/><div style="flex:1;min-width:220px"><h2>{lang==='ar'?'مرحباً، أنا أحمد':'Hi, I’m Ahmad'}</h2><p class="muted">{t.intro}. {site.tagline}.</p><a class="btn secondary" href={`/${lang}/about/`}>{t.about}</a></div></section></div></Base>
