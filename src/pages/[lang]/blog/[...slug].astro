---
import Base from '../../../layouts/Base.astro';import {getCollection,render} from 'astro:content';import {posts,articleUrl} from '../../../lib/site';import ArticleCard from '../../../components/ArticleCard.astro';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>!data.draft)).map(post=>({params:{lang:post.data.lang,slug:post.id},props:{post}}))}
const {post}=Astro.props;const {Content,headings}=await render(post);const related=(await posts(post.data.lang)).filter(p=>p.id!==post.id&&(p.data.category===post.data.category||p.data.tags.some((tag:string)=>post.data.tags.includes(tag)))).slice(0,3);const words=(post.body ?? '').trim().split(/\s+/).filter(Boolean).length;const minutes=Math.max(1,Math.ceil(words/220));
---
<Base lang={post.data.lang} title={post.data.title} description={post.data.description} image={post.data.cover||'/assets/cover.png'} type="article"><article class="wrap section"><a class="muted" href={`/${post.data.lang}/blog/`}>← Blog</a><header style="max-width:760px"><p><span class="tag">{post.data.category}</span></p><h1 style="font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.15">{post.data.title}</h1><p class="muted">{post.data.description}</p><p class="muted"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(post.data.lang==='ar'?'ar':'en',{dateStyle:'long'})}</time> · {minutes} min read</p><div class="socials"><button class="btn secondary" id="share">Share</button><button class="btn secondary" id="copylink">Copy link</button></div></header><div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(160px,230px);gap:40px;margin-top:38px" class="article-grid"><div class="prose"><Content/></div><aside><div class="glass" style="padding:18px;position:sticky;top:15px"><strong>On this page</strong><nav class="toc" aria-label="Table of contents">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} style={`padding-inline-start:${(h.depth-2)*12}px`}>{h.text}</a>)}</nav></div></aside></div>{related.length>0&&<section class="section"><h2>Related articles</h2><div class="cards">{related.map(p=><ArticleCard post={p}/>)}</div></section>}</article></Base><style>@media(max-width:750px){.article-grid{grid-template-columns:1fr!important}.article-grid aside{grid-row:1}}</style><script>document.querySelector('#copylink')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);const b=document.querySelector('#copylink');if(b)b.textContent='Copied!'});document.querySelector('#share')?.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title:document.title,url:location.href})}catch{}}else{await navigator.clipboard.writeText(location.href)}});document.querySelectorAll('.prose pre').forEach(pre=>{const b=document.createElement('button');b.textContent='Copy code';b.className='btn secondary';b.style.margin='8px 0';b.addEventListener('click',async()=>{await navigator.clipboard.writeText(pre.textContent||'');b.textContent='Copied!'});pre.before(b)});</script>
