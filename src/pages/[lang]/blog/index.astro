---
import Base from '../../../layouts/Base.astro';import ArticleCard from '../../../components/ArticleCard.astro';import {copy,posts} from '../../../lib/site';
export function getStaticPaths(){return [{params:{lang:'en'}},{params:{lang:'ar'}}]}
const lang=Astro.params.lang as 'en'|'ar';const t=copy[lang];const all=await posts(lang);const categories=[...new Set(all.map(x=>x.data.category))];
---
<Base lang={lang} title={t.blog}><section class="wrap section"><h1 style="font-size:3rem">{t.blog}</h1><p class="muted">{lang==='ar'?'أفكار ودروس في البرمجة والذكاء الاصطناعي':'Thoughts and tutorials on software and intelligent systems.'}</p><div class="controls"><input id="search" type="search" placeholder={t.search} aria-label={t.search}/><select id="category" aria-label="Category"><option value="">{t.all}</option>{categories.map(c=><option value={c}>{c}</option>)}</select><select id="sort" aria-label={t.sort}><option value="newest">{t.newest}</option><option value="oldest">{t.oldest}</option></select></div><div id="articles" class="cards">{all.map(post=><div data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()} data-tags={post.data.tags.join(' ').toLowerCase()} data-category={post.data.category} data-date={post.data.date.getTime()}><ArticleCard post={post}/></div>)}</div><p id="empty" hidden class="muted">No matching articles.</p><nav class="pagination" id="pages" aria-label="Article pages"></nav></section></Base>
<script>
const search=document.querySelector<HTMLInputElement>('#search')!,category=document.querySelector<HTMLSelectElement>('#category')!,sort=document.querySelector<HTMLSelectElement>('#sort')!,root=document.querySelector<HTMLElement>('#articles')!,pages=document.querySelector<HTMLElement>('#pages')!,empty=document.querySelector<HTMLElement>('#empty')!;const items=[...root.children] as HTMLElement[];let page=1;const size=6;const q=new URLSearchParams(location.search).get('category');if(q&&[...category.options].some(o=>o.value===q))category.value=q;function render(){let visible=items.filter(el=>(!category.value||el.dataset.category===category.value)&&`${el.dataset.title} ${el.dataset.description} ${el.dataset.tags}`.includes(search.value.toLowerCase().trim())).sort((a,b)=>(Number(b.dataset.date)-Number(a.dataset.date))*(sort.value==='newest'?1:-1));const count=Math.ceil(visible.length/size);page=Math.min(page,Math.max(count,1));items.forEach(el=>el.hidden=true);visible.slice((page-1)*size,page*size).forEach(el=>el.hidden=false);empty.hidden=visible.length>0;pages.replaceChildren();for(let n=1;n<=count;n++){const btn=document.createElement('button');btn.textContent=String(n);btn.setAttribute('aria-current',String(n===page));btn.addEventListener('click',()=>{page=n;render();root.scrollIntoView({behavior:'smooth'})});pages.append(btn)}}[search,category,sort].forEach(el=>el.addEventListener('input',()=>{page=1;render()}));render();
</script>
