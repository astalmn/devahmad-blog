---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { posts } from '../lib/site';
import { getCollection } from 'astro:content';

const latest = (await posts()).slice(0, 3);
const allProjects = await getCollection('projects', ({ data }) => data.lang === 'ar');

const preferred = ['zaka-plus', 'athkari', 'noor-quran'];
const projects = [
  ...preferred
    .map(id => allProjects.find(project => project.id === id))
    .filter(Boolean),
  ...allProjects.filter(project => !preferred.includes(project.id))
].slice(0, 3);
---

<Base title="DevAhmad">
  <div class="wrap">
    <section class="hero" style="margin-top:28px">
      <img
        src="/assets/cover.png"
        width="1536"
        height="614"
        alt="مساحة عمل DevAhmad"
        fetchpriority="high"
      />

      <div class="hero-content">
        <span class="eyebrow">البرمجة · الذكاء الاصطناعي · الأنظمة الذكية</span>
        <h1>أفكار برمجية،<br />وأنظمة أذكى.</h1>
        <p>
          أبني تطبيقات ويب ومنتجات ذكية تجمع بين البرمجة والذكاء الاصطناعي،
          وأشارك هنا المشاريع والتجارب والمقالات التقنية.
        </p>

        <div class="controls">
          <a class="btn" href="/projects/">استكشف المشاريع</a>
          <a class="btn secondary" href="/blog/">اقرأ المدونة</a>
        </div>
      </div>
    </section>

    <section class="section featured-projects">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Selected Work</span>
          <h2 class="section-title">مشاريعي المميزة</h2>
          <p class="muted">
            مشاريع حقيقية قابلة للتجربة مباشرة، من تطبيقات الويب إلى أدوات الذكاء الاصطناعي.
          </p>
        </div>

        <a class="btn secondary section-link" href="/projects/">جميع المشاريع ←</a>
      </div>

      <div class="featured-grid">
        {projects.map(project => <ProjectCard project={project} featured />)}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">أحدث المقالات</h2>
      <div class="cards">
        {latest.map(post => <ArticleCard post={post} />)}
      </div>
      <p><a class="btn secondary" href="/blog/">جميع المقالات ←</a></p>
    </section>

    <section class="section">
      <h2 class="section-title">مجالات الاهتمام</h2>
      <div class="cards">
        {[
          'الذكاء الاصطناعي',
          'TypeScript',
          'تطوير الويب',
          'الأنظمة الذكية',
          'أمن التطبيقات',
          'هندسة البرمجيات'
        ].map(topic => (
          <a class="glass card" href="/blog/">
            <span class="eyebrow" style="font-size:1.6rem">⌘</span>
            <h3>{topic}</h3>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="glass skills-block">
        <div>
          <span class="eyebrow">Core Stack</span>
          <h2 class="section-title">التقنيات التي أعمل بها</h2>
          <p class="muted">
            مجموعة التقنيات الأساسية التي أستخدمها لبناء التطبيقات والمنتجات الرقمية.
          </p>
        </div>

        <div class="skills-list" aria-label="التقنيات">
          {[
            'TypeScript',
            'React',
            'Astro',
            'HTML5',
            'CSS3',
            'Cloudflare',
            'Supabase',
            'AI Integration'
          ].map(skill => <span>{skill}</span>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="glass about-layout about-home">
        <img
          class="profile"
          src="/assets/profile.png"
          width="220"
          height="220"
          alt="الصورة الشخصية"
          loading="lazy"
        />

        <div class="prose">
          <span class="eyebrow">DevAhmad</span>
          <h2>مرحبًا، أنا أحمد</h2>
          <p>
            أركز على تطوير الويب والأنظمة الذكية وبناء منتجات عملية قابلة للتطوير،
            مع اهتمام خاص بتجربة المستخدم والذكاء الاصطناعي.
          </p>
          <a class="btn secondary" href="/about/">تعرف عليّ</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .featured-projects{
    margin-top:clamp(42px,7vw,78px);
  }

  .section-heading{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:24px;
    margin-bottom:24px;
  }

  .section-heading .section-title{
    margin:.35rem 0 .45rem;
  }

  .section-heading p{
    margin:0;
    max-width:650px;
    line-height:1.8;
  }

  .featured-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:22px;
  }

  .featured-grid :global(.project-card){
    height:100%;
  }

  .skills-block{
    padding:clamp(24px,4vw,36px);
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(320px,1.1fr);
    align-items:center;
    gap:30px;
  }

  .skills-block .section-title{
    margin:.35rem 0 .5rem;
  }

  .skills-block p{
    margin:0;
    line-height:1.8;
  }

  .skills-list{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
  }

  .skills-list span{
    padding:9px 13px;
    border-radius:999px;
    border:1px solid rgba(105,166,215,.28);
    background:rgba(23,57,90,.38);
    color:#c6dcf2;
    font-size:.88rem;
    font-weight:750;
  }

  .about-home{
    padding:28px;
  }

  @media(max-width:980px){
    .featured-grid{
      grid-template-columns:repeat(2,minmax(0,1fr));
    }

    .skills-block{
      grid-template-columns:1fr;
    }
  }

  @media(max-width:680px){
    .section-heading{
      align-items:flex-start;
      flex-direction:column;
    }

    .section-link{
      width:100%;
      text-align:center;
    }

    .featured-grid{
      grid-template-columns:1fr;
      gap:18px;
    }

    .skills-block{
      padding:22px;
    }

    .skills-list{
      gap:8px;
    }

    .skills-list span{
      font-size:.8rem;
      padding:8px 11px;
    }
  }
</style>
