---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {posts} from '../lib/site';
import {getCollection} from 'astro:content';
const latest=(await posts()).slice(0,3);
const projects=(await getCollection('projects',({data})=>data.lang==='ar')).slice(0,3);
---
<Base title="DevAhmad"><div class="wrap"><section class="hero" style="margin-top:28px"><img src="/assets/cover.png" width="1536" height="614" alt="مساحة عمل DevAhmad" fetchpriority="high"/><div class="hero-content"><span class="eyebrow">البرمجة · الذكاء الاصطناعي · الأنظمة الذكية</span><h1>أفكار برمجية،<br/>وأنظمة أذكى.</h1><p>مقالات تقنية ومشاريع تعليمية وتجارب عملية في عالم تطوير البرمجيات.</p><div class="controls"><a class="btn" href="/blog/">استكشف المدونة</a><a class="btn secondary" href="/projects/">تصفح المشاريع</a></div></div></section><section class="section"><h2 class="section-title">أحدث المقالات</h2><div class="cards">{latest.map(post=><ArticleCard post={post}/>)}</div><p><a class="btn secondary" href="/blog/">جميع المقالات ←</a></p></section><section class="section"><h2 class="section-title">مجالات الاهتمام</h2><div class="cards">{['الذكاء الاصطناعي','TypeScript','تطوير الويب','الأنظمة الذكية','أمن التطبيقات','هندسة البرمجيات'].map(topic=><a class="glass card" href="/blog/"><span class="eyebrow" style="font-size:1.6rem">⌘</span><h3>{topic}</h3></a>)}</div></section><section class="section"><h2 class="section-title">مشاريع مختارة</h2><div class="cards">{projects.map(project=><a class="glass card" href={`/projects/${project.id}/`}><span class="tag">{project.data.stack.join(' · ')}</span><h3>{project.data.title}</h3><p class="muted">{project.data.description}</p><span class="eyebrow">التفاصيل ←</span></a>)}</div></section><section class="section"><div class="glass about-layout" style="padding:28px"><img class="profile" src="/assets/profile.png" width="220" height="220" alt="الصورة الشخصية" loading="lazy"/><div class="prose"><h2>مرحبًا، أنا أحمد</h2><p>أشارك هنا ما أتعلمه وأطوره في البرمجة والذكاء الاصطناعي والأنظمة الذكية.</p><a class="btn secondary" href="/about/">تعرف عليّ</a></div></div></section></div></Base>
