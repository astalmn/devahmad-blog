---
interface Props {
  src: string;
  title?: string;
}
const { src, title = 'معاينة التطبيق' } = Astro.props;
---

<section class="phone-preview" aria-label={title}>
  <div class="phone-shell">
    <div class="phone-speaker" aria-hidden="true"></div>
    <div class="phone-camera" aria-hidden="true"></div>
    <div class="phone-screen">
      <iframe
        src={src}
        title={title}
        loading="lazy"
        allow="clipboard-write; web-share"
      ></iframe>
    </div>
    <div class="phone-home" aria-hidden="true"></div>
  </div>

  <div class="phone-actions">
    <a class="btn" href={src} target="_blank" rel="noopener noreferrer">
      فتح التطبيق بملء الشاشة
    </a>
  </div>
</section>

<style>
  .phone-preview{
    display:grid;
    justify-items:center;
    gap:20px;
    margin:32px auto;
  }
  .phone-shell{
    position:relative;
    width:min(100%,390px);
    height:min(78vh,780px);
    min-height:620px;
    padding:34px 10px 28px;
    border:3px solid #263244;
    border-radius:46px;
    background:#0b1018;
    box-shadow:0 24px 70px rgba(0,0,0,.28), inset 0 0 0 2px rgba(255,255,255,.06);
    overflow:hidden;
  }
  .phone-screen{
    width:100%;
    height:100%;
    overflow:hidden;
    border-radius:30px;
    background:#fff;
  }
  .phone-screen iframe{
    display:block;
    width:100%;
    height:100%;
    border:0;
    background:#fff;
  }
  .phone-speaker{
    position:absolute;
    top:15px;
    left:50%;
    width:70px;
    height:5px;
    border-radius:999px;
    background:#3c4654;
    transform:translateX(-50%);
  }
  .phone-camera{
    position:absolute;
    top:13px;
    left:calc(50% + 48px);
    width:9px;
    height:9px;
    border-radius:50%;
    background:#253247;
    box-shadow:inset 0 0 0 2px #111722;
  }
  .phone-home{
    position:absolute;
    bottom:9px;
    left:50%;
    width:92px;
    height:5px;
    border-radius:999px;
    background:#5c6674;
    transform:translateX(-50%);
  }
  .phone-actions{
    display:flex;
    justify-content:center;
  }
  @media(max-width:520px){
    .phone-shell{
      width:min(94vw,390px);
      height:72vh;
      min-height:560px;
      border-radius:40px;
    }
  }
</style>
