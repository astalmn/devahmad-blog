---
import {articleUrl} from '../lib/site';
import type {CollectionEntry} from 'astro:content';
const {post}=Astro.props as {post:CollectionEntry<'blog'>};
---
<article class="glass card"><span class="tag">{post.data.category}</span><h3><a href={articleUrl(post.id)}>{post.data.title}</a></h3><p class="muted">{post.data.description}</p><div style="display:flex;justify-content:space-between;gap:10px;align-items:center"><time class="muted" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ar',{dateStyle:'medium'})}</time><a href={articleUrl(post.id)} style="color:#70dfff;font-weight:700">اقرأ المقال ←</a></div></article>
