---
interface Props{pageId:string;title:string}
const{pageId,title}=Astro.props;
---
<section class="glass comments-box" aria-label="تعليقات القراء"><h2>تعليقات القراء</h2><div id="comments-list" class="comments-list"><p class="muted">جاري تحميل التعليقات...</p></div><form id="comment-form"><input name="name" placeholder="الاسم" maxlength="80" required/><input name="email" type="email" placeholder="البريد الإلكتروني (اختياري)" maxlength="160"/><textarea name="content" placeholder="اكتب تعليقك..." maxlength="2000" required></textarea><button class="btn" type="submit">إرسال التعليق</button><p id="comment-message" class="muted"></p></form></section>
<script define:vars={{pageId,title}}>
const list=document.querySelector("#comments-list"),form=document.querySelector("#comment-form"),msg=document.querySelector("#comment-message");
async function loadComments(){try{const r=await fetch(`/api/comments?page=${encodeURIComponent(pageId)}`),d=await r.json();if(!d.comments?.length){list.innerHTML="<p class='muted'>لا توجد تعليقات بعد.</p>";return}list.innerHTML=d.comments.map(c=>`<article class="comment"><strong>${c.name}</strong><p>${c.content}</p><small>${new Date(c.created_at).toLocaleString("ar", {timeZone:"Asia/Gaza", dateStyle:"medium", timeStyle:"short"})}</small></article>`).join("")}catch{list.innerHTML="<p class='muted'>تعذر تحميل التعليقات.</p>"}}
form?.addEventListener("submit",async e=>{e.preventDefault();const f=new FormData(form),r=await fetch("/api/comments",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({page_id:pageId,article_title:title,name:f.get("name"),email:f.get("email"),content:f.get("content")})}),d=await r.json();msg.textContent=d.message||d.error;if(d.success)form.reset()});
loadComments();
</script>
<style>
.comments-box{margin-block:48px;padding:24px}.comments-list{display:grid;gap:16px;margin-block:24px}.comment{padding:16px;border-radius:14px;background:rgba(255,255,255,.04)}.comment p{margin:8px 0}form{display:grid;gap:12px}input,textarea{width:100%;padding:12px;border-radius:10px}textarea{min-height:120px;resize:vertical}
</style>
