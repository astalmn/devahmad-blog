---
interface Props{pageId:string;title:string}
const{pageId,title}=Astro.props;
---
<section class="glass comments-box" aria-label="تعليقات القراء"><h2>تعليقات القراء</h2><div id="comments-list" class="comments-list"><p class="muted">جاري تحميل التعليقات...</p></div><form id="comment-form"><input name="name" placeholder="الاسم" maxlength="80" required/><input name="email" type="email" placeholder="البريد الإلكتروني (اختياري)" maxlength="160"/><textarea name="content" placeholder="اكتب تعليقك..." maxlength="2000" required></textarea><button class="btn" type="submit">إرسال التعليق</button><p id="comment-message" class="muted"></p></form></section>
<script define:vars={{pageId,title}}>
const list=document.querySelector("#comments-list"),form=document.querySelector("#comment-form"),msg=document.querySelector("#comment-message");const esc=v=>String(v??"").replace(/[&<>"']/g,ch=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]));const gazaTime=v=>{const raw=String(v??"").trim();if(!raw)return"";const normalized=/[zZ]|[+-]\d\d:?\d\d$/.test(raw)?raw:raw.replace(" ","T")+"Z";const date=new Date(normalized);return Number.isNaN(date.getTime())?raw:new Intl.DateTimeFormat("ar-PS",{timeZone:"Asia/Gaza",year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit",hour12:true}).format(date)};async function loadComments(){try{const r=await fetch(`/api/comments?page=${encodeURIComponent(pageId)}`,{cache:"no-store"}),d=await r.json();if(!r.ok)throw new Error(d.error||"load failed");if(!d.comments?.length){list.innerHTML="<p class='muted'>لا توجد تعليقات بعد.</p>";return}list.innerHTML=d.comments.map(c=>`<article class="comment"><strong>${esc(c.name)}</strong><p>${esc(c.content)}</p><small>${gazaTime(c.created_at)}</small></article>`).join("")}catch{list.innerHTML="<p class='muted'>تعذر تحميل التعليقات.</p>"}}form?.addEventListener("submit",async e=>{e.preventDefault();const button=form.querySelector('button[type="submit"]');if(button)button.disabled=true;msg.textContent="جاري إرسال التعليق...";try{const f=new FormData(form),r=await fetch("/api/comments",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({page_id:pageId,article_title:title,name:f.get("name"),email:f.get("email"),content:f.get("content")})}),d=await r.json();msg.textContent=d.message||d.error||"";if(d.success){form.reset();await loadComments()}}catch{msg.textContent="تعذر إرسال التعليق. حاول مرة أخرى."}finally{if(button)button.disabled=false}});loadComments();
</script>
<style>
.comments-box{margin-block:48px;padding:24px;border:1px solid rgba(82,142,207,.48);border-radius:28px;background:rgba(8,27,51,.72)}.comments-box h2{margin:0 0 8px;font-size:clamp(1.8rem,5vw,2.45rem)}.comments-list{display:grid;gap:14px;margin-block:24px}.comment{position:relative;padding:18px 20px;border:1px solid rgba(82,142,207,.55);border-radius:16px;background:linear-gradient(145deg,rgba(22,48,78,.72),rgba(9,30,55,.78));box-shadow:0 8px 24px rgba(0,0,0,.12);overflow-wrap:anywhere}.comment strong{display:block;margin-bottom:9px;color:#f2f7ff;font-size:1.08rem;font-weight:700}.comment p{margin:0 0 12px;color:#e4edf8;line-height:1.85;white-space:pre-wrap}.comment small{display:block;padding-top:10px;border-top:1px solid rgba(82,142,207,.22);color:#9fb6d2;font-size:.82rem;direction:rtl;unicode-bidi:isolate}form{display:grid;gap:12px;margin-top:8px}input,textarea{box-sizing:border-box;width:100%;padding:14px 16px;border:1px solid rgba(82,142,207,.58);border-radius:14px;background:rgba(10,31,56,.9);color:#fff;outline:none;transition:border-color .2s,box-shadow .2s}input:focus,textarea:focus{border-color:#4b91e8;box-shadow:0 0 0 3px rgba(75,145,232,.12)}input::placeholder,textarea::placeholder{color:#9fb1c8}textarea{min-height:130px;resize:vertical}.comments-box .btn{min-height:52px;border-radius:14px}button:disabled{opacity:.65;cursor:not-allowed}@media(max-width:640px){.comments-box{padding:18px 14px;border-radius:22px}.comment{padding:16px}.comments-list{gap:12px}}
</style>
