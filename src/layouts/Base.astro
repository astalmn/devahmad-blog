---
import '../styles/global.css';
import { site, labels } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  robots?: string;
}

const {
  title = site.name,
  description = 'مقالات ومشاريع في البرمجة والذكاء الاصطناعي والأنظمة الذكية.',
  image = '/assets/cover.png',
  imageAlt = 'DevAhmad — Programmer & Intelligent Systems Engineer',
  type = 'website',
  robots = 'index,follow,max-image-preview:large'
} = Astro.props;

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://devahmad-blog.pages.dev'
);

const og = new URL(image, canonical);
const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;

const nav = [
  { href: '/', text: labels.home },
  { href: '/blog/', text: labels.blog },
  { href: '/projects/', text: labels.projects },
  { href: '/about/', text: labels.about },
  { href: '/resources/', text: labels.resources },
  { href: '/contact/', text: labels.contact }
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DevAhmad',
  url: canonical.origin,
  inLanguage: 'ar',
  description: 'مقالات ومشاريع في البرمجة والذكاء الاصطناعي والأنظمة الذكية.'
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ahmad',
  alternateName: 'DevAhmad',
  url: canonical.origin,
  jobTitle: 'Programmer | Intelligent Systems Engineer',
  sameAs: [site.github].filter(Boolean)
};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#071225" />
    <meta name="color-scheme" content="dark light" />

    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DevAhmad RSS"
      href="/rss.xml"
    />

    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content="DevAhmad" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:secure_url" content={og} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    ></script>
  </head>

  <body>
    <a class="skip" href="#main">انتقل إلى المحتوى</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="DevAhmad الرئيسية">
          <span>Dev</span>Ahmad
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-label="فتح القائمة"
          aria-expanded="false"
          aria-controls="main-navigation"
        >
          <span></span><span></span><span></span>
        </button>

        <nav id="main-navigation" aria-label="القائمة الرئيسية" class="main-nav">
          {nav.map(item => (
            <a
              href={item.href}
              aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <a class="brand" href="/"><span>Dev</span>Ahmad</a>
          <p class="muted">أفكار برمجية وأنظمة أذكى.</p>
        </div>

        <div class="footer-links">
          <a href="/contact/">تواصل</a>
          <a href="/privacy/">الخصوصية</a>
          <a href="/rss.xml">RSS</a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>

        <small class="muted">© {new Date().getFullYear()} DevAhmad</small>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const button = document.querySelector('.menu-toggle');
        const nav = document.querySelector('#main-navigation');

        if (!button || !nav) return;

        const closeMenu = () => {
          nav.classList.remove('is-open');
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-label', 'فتح القائمة');
          document.body.classList.remove('nav-open');
        };

        button.addEventListener('click', () => {
          const open = !nav.classList.contains('is-open');
          nav.classList.toggle('is-open', open);
          button.setAttribute('aria-expanded', String(open));
          button.setAttribute('aria-label', open ? 'إغلاق القائمة' : 'فتح القائمة');
          document.body.classList.toggle('nav-open', open);
        });

        nav.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('keydown', event => {
          if (event.key === 'Escape') closeMenu();
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 780) closeMenu();
        });
      })();
    </script>

    <style is:global>
      .menu-toggle{
        display:none;
        width:44px;
        height:44px;
        padding:10px;
        border:1px solid rgba(126,164,200,.26);
        border-radius:12px;
        background:rgba(18,42,68,.48);
        color:inherit;
        cursor:pointer;
      }

      .menu-toggle span{
        display:block;
        width:100%;
        height:2px;
        margin:4px 0;
        border-radius:99px;
        background:currentColor;
        transition:transform .18s ease,opacity .18s ease;
      }

      @media(max-width:780px){
        body.nav-open{overflow:hidden}

        .site-header{
          position:sticky;
          top:0;
          z-index:100;
          backdrop-filter:blur(16px);
          -webkit-backdrop-filter:blur(16px);
          background:rgba(7,18,37,.86);
          border-bottom:1px solid rgba(113,151,190,.14);
        }

        .header-inner{
          position:relative;
          min-height:64px;
          display:flex;
          align-items:center;
          justify-content:space-between;
          gap:14px;
        }

        .brand{
          font-size:1.25rem;
          position:relative;
          z-index:102;
        }

        .menu-toggle{
          display:block;
          position:relative;
          z-index:102;
          flex:0 0 auto;
        }

        .menu-toggle[aria-expanded="true"] span:nth-child(1){
          transform:translateY(6px) rotate(45deg);
        }

        .menu-toggle[aria-expanded="true"] span:nth-child(2){
          opacity:0;
        }

        .menu-toggle[aria-expanded="true"] span:nth-child(3){
          transform:translateY(-6px) rotate(-45deg);
        }

        .main-nav{
          position:fixed;
          inset:64px 0 auto;
          z-index:101;
          display:grid !important;
          gap:7px;
          padding:14px max(16px,calc((100vw - 1120px)/2));
          max-height:calc(100dvh - 64px);
          overflow:auto;
          background:rgba(7,18,37,.98);
          border-bottom:1px solid rgba(113,151,190,.18);
          box-shadow:0 22px 45px rgba(0,0,0,.3);
          transform:translateY(-115%);
          opacity:0;
          visibility:hidden;
          pointer-events:none;
          transition:transform .2s ease,opacity .2s ease,visibility .2s ease;
        }

        .main-nav.is-open{
          transform:translateY(0);
          opacity:1;
          visibility:visible;
          pointer-events:auto;
        }

        .main-nav a{
          display:flex;
          align-items:center;
          min-height:48px;
          padding:10px 14px;
          border-radius:11px;
          text-decoration:none;
          font-weight:700;
        }

        .main-nav a:hover,
        .main-nav a[aria-current="page"]{
          background:rgba(66,128,188,.15);
        }

        .wrap{
          width:min(100% - 28px,1120px);
        }

        .section{
          padding-block:clamp(34px,8vw,58px);
        }

        .hero{
          border-radius:20px;
          overflow:hidden;
        }

        .hero-content{
          padding:clamp(20px,6vw,30px);
        }

        .controls{
          gap:10px;
        }

        .controls .btn{
          min-height:44px;
        }

        .site-footer .footer-inner{
          gap:22px;
        }

        .footer-links{
          display:flex;
          flex-wrap:wrap;
          gap:10px 16px;
        }
      }

      @media(max-width:520px){
        .wrap{
          width:min(100% - 22px,1120px);
        }

        .hero{
          margin-top:18px !important;
        }

        .hero-content h1{
          font-size:clamp(2rem,11vw,3rem);
        }

        .controls{
          display:grid;
          grid-template-columns:1fr;
        }

        .controls .btn{
          width:100%;
          text-align:center;
          justify-content:center;
        }

        .section-title{
          line-height:1.3;
        }

        .site-footer{
          padding-bottom:max(22px,env(safe-area-inset-bottom));
        }
      }

      @media(prefers-reduced-motion:reduce){
        .menu-toggle span,
        .main-nav{
          transition:none;
        }
      }
    </style>
  </body>
</html>
