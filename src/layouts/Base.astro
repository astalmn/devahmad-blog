---
import '../styles/global.css';
import { site, labels } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  robots?: string;
}

const {
  title = site.name,
  description = 'مقالات ومشاريع في البرمجة والذكاء الاصطناعي والأنظمة الذكية.',
  image = '/assets/cover.png',
  imageAlt = 'DevAhmad — Programmer & Intelligent Systems Engineer',
  type = 'website',
  robots = 'index,follow,max-image-preview:large'
} = Astro.props;

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://devahmad-blog.pages.dev'
);

const og = new URL(image, canonical);
const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;

const nav = [
  { href: '/', text: labels.home },
  { href: '/blog/', text: labels.blog },
  { href: '/projects/', text: labels.projects },
  { href: '/about/', text: labels.about },
  { href: '/resources/', text: labels.resources },
  { href: '/contact/', text: labels.contact }
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DevAhmad',
  url: canonical.origin,
  inLanguage: 'ar',
  description: 'مقالات ومشاريع في البرمجة والذكاء الاصطناعي والأنظمة الذكية.'
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ahmad',
  alternateName: 'DevAhmad',
  url: canonical.origin,
  jobTitle: 'Programmer | Intelligent Systems Engineer',
  sameAs: [site.github].filter(Boolean)
};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#071225" />
    <meta name="color-scheme" content="dark light" />

    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DevAhmad RSS"
      href="/rss.xml"
    />

    <meta property="og:locale" content="ar_AR" />
    <meta property="og:site_name" content="DevAhmad" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:secure_url" content={og} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    ></script>
  </head>

  <body>
    <a class="skip" href="#main">انتقل إلى المحتوى</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="DevAhmad الرئيسية">
          <span>Dev</span>Ahmad
        </a>

        <nav aria-label="القائمة الرئيسية" class="main-nav">
          {nav.map(item => (
            <a
              href={item.href}
              aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <a class="brand" href="/"><span>Dev</span>Ahmad</a>
          <p class="muted">أفكار برمجية وأنظمة أذكى.</p>
        </div>

        <div class="footer-links">
          <a href="/contact/">تواصل</a>
          <a href="/privacy/">الخصوصية</a>
          <a href="/rss.xml">RSS</a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>

        <small class="muted">© {new Date().getFullYear()} DevAhmad</small>
      </div>
    </footer>
  </body>
</html>
